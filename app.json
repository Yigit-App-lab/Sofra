{
  "expo": {
    "name": "Sofra",
    "slug": "sofra-app",
    "version": "0.1.0",
    "scheme": "sofra",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "tr",
              "en"
            ],
            "android": [
              "tr",
              "en"
            ]
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1093576749212-kd7pauhk24giumbl2jc83s0qgdkioa85"
        }
      ],
      "expo-apple-authentication"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yberktas.sofra",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yberktas.sofra"
    }
  }
}
